{
  "installCommand": "npm install && npm run build -w shared",
  "buildCommand": "npm run build -w shared && npm run build -w frontend",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.ts": {
      "maxDuration": 60,
      "excludeFiles": "node_modules/puppeteer/**"
    }
  }
}
